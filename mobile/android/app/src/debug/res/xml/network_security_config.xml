<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de seguridad de red SOLO para builds de DEBUG.

  En desarrollo la app entra por el API Gateway publicado en el host (puerto
  3000). Según dónde corra:
    - Emulador Android: http://10.0.2.2:3000
    - Dispositivo físico: http://<IP-LAN-del-equipo>:3000 (la IP varía por red)

  Como la IP LAN del equipo de desarrollo cambia, en DEBUG permitimos tráfico en
  claro (HTTP) a cualquier host. Además confiamos en el certificado AUTOFIRMADO
  de dev (res/raw/isy_dev_ca.crt) para el caso HTTPS por nginx (443), junto con
  las CAs del sistema.

  IMPORTANTE: este archivo NO se incluye en el build de release. En release la
  app exige HTTPS con CA pública (y, más adelante, SSL pinning).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="@raw/isy_dev_ca"/>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
