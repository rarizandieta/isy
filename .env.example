# Isy — variables de entorno de ejemplo (copiar a .env y ajustar)
# NO comitear .env real. Estas credenciales son solo para desarrollo.

# --- PostgreSQL ---
POSTGRES_USER=isy
POSTGRES_PASSWORD=isy
POSTGRES_DB=isy

# --- URLs internas (red de Docker) ---
IDENTITY_URL=http://identity:3001
MINISTORES_URL=http://ministores:3002
REDIS_URL=redis://redis:6379

# --- JWT (generar par de claves; NO incrustar en el cliente) ---
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
ACCESS_TTL=900          # 15 min
REFRESH_TTL=2592000     # 30 días
